#!/bin/sh
# Block pushes that introduce accessibility violations.
# Builds the app and runs pa11y-ci (WCAG2AA) against the preview.
# Wired via `git config core.hooksPath .githooks` (the package.json "prepare" script).
#
# Requires Node 24 (see .nvmrc); loads nvm's Node 24 if available.
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.nvm/nvm.sh"
  nvm use 24 >/dev/null 2>&1 || true
fi

# Narrow the matrix by what is being pushed.
#
# The fixture tier is what proves the required render shapes still pass, so any
# change that could reach the UI runs it — that is the default, not a special case.
# The live tier only sweeps real digests for content drift and guarantees no shape,
# so it is worth running only when digest data itself changed. Paths that cannot
# affect either — specs, docs, CI and hook config — skip the check outright.
#
# Scoping is an optimization; the Accessibility workflow on the PR always runs
# the full matrix.
range=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
if [ -n "$range" ]; then
  changed=$(git diff --name-only "$range"...HEAD)
else
  changed=$(git diff --name-only HEAD~1...HEAD 2>/dev/null)
fi

# Paths with no effect on the rendered app.
inert_re='^(openspec/|docs/|\.github/|\.githooks/|[^/]+\.md$)'

if [ -z "$changed" ]; then
  tier=all
else
  data=$(printf '%s\n' "$changed" | grep -E '^digests/' || true)
  code=$(printf '%s\n' "$changed" | grep -vE "$inert_re" | grep -vE '^digests/' || true)

  if [ -n "$data" ] && [ -n "$code" ]; then
    tier=all
  elif [ -n "$data" ]; then
    tier=live
  elif [ -n "$code" ]; then
    tier=fixture
  else
    echo "pre-push: only specs/docs/CI config changed — skipping accessibility check."
    exit 0
  fi
fi

echo "pre-push: running accessibility check (tier=$tier)…"
if ! A11Y_TIER="$tier" npm run test:a11y:ci; then
  echo "pre-push: accessibility check failed — push aborted. Fix the reported issues or run 'npm run test:a11y:ci' locally to reproduce." >&2
  echo "pre-push: to bypass in an emergency, use 'git push --no-verify'." >&2
  exit 1
fi

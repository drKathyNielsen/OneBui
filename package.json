{
  "name": "onebui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --port 4173 --strictPort",
    "a11y:urls": "node scripts/gen-pa11y-urls.mjs",
    "test:a11y:ci": "VITE_A11Y_FIXTURES=1 npm run build && npm run a11y:urls && start-server-and-test preview http://localhost:4173 \"pa11y-ci --config .pa11yci.json\"",
    "prepare": "git config core.hooksPath .githooks"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "puppeteer": "^25.8.0",
    "puppeteer-core": "^25.8.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react": "^19.2.7",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "pa11y-ci": "^4.1.1",
    "start-server-and-test": "^2.1.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "puppeteer": true
  }
}
